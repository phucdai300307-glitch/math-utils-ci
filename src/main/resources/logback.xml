<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="info">
        <appender-ref ref="STDOUT" />
    </root>

    <!-- Cấu hình riêng cho package com.math để hiển thị DEBUG logs -->
    <logger name="com.math" level="debug" additivity="false">
        <appender-ref ref="STDOUT" />
    </logger>

</configuration>
